# ============================================================
# Secrets and local configuration
# ============================================================
# The lab .env files are tracked upstream as placeholder templates,
# so .gitignore does NOT protect them. Stop tracking local edits with:
#   git ls-files '*.env' | xargs git update-index --skip-worktree
.env
.env.*
*.env
!.env.example
!.env.template
!.env.sample

# Credentials, keys and certificates
*.pem
*.key
*.pfx
*.p12
*.crt
*.cer
secrets.json
credentials.json
local.settings.json
appsettings.*.local.json

# Azure CLI / azd local state
.azure/

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/
labenv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
htmlcov/
.ipynb_checkpoints/

# ============================================================
# .NET (kept from the upstream repository)
# ============================================================
bin
obj
*.sln

# ============================================================
# Generated lab output
# ============================================================
# Audio generated by the text-to-speech lab.
# Tracked sample media (*.wav, *.mp4) in the repo is not affected.
Labfiles/03-gen-ai-speech/Python/generate-speech/speech.mp3

